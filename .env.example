# PostgreSQL (used by docker-compose to create the database container)
POSTGRES_USER=invictus
POSTGRES_PASSWORD=invictus_dev_password
POSTGRES_DB=invictus

# Connection string used by the web app (Prisma).
# Inside docker-compose the host is the service name "db".
DATABASE_URL=postgresql://invictus:invictus_dev_password@db:5432/invictus?schema=public
