# PostgreSQL (used by docker-compose to create the database container)
POSTGRES_USER=invictus
POSTGRES_PASSWORD=invictus_dev_password
POSTGRES_DB=invictus

# Connection string used by the web app (Prisma).
# Inside docker-compose the host is the service name "db".
DATABASE_URL=postgresql://invictus:invictus_dev_password@db:5432/invictus?schema=public

# Auth.js (NextAuth) -- change AUTH_SECRET for anything beyond local use (openssl rand -base64 32).
AUTH_SECRET=dev-only-change-me-1c9f6b2a7e4d4f0b9a3c8e5d2f1b6a9c
AUTH_TRUST_HOST=true

# Optional: SMTP for the "book another court" email notification to the directiva.
# Leave unset in local/dev -- the app falls back to logging the email to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Invictus Padel Club <no-reply@invictuspadel.local>"
NOTIFY_EMAIL_TO=directiva@invictuspadel.local
